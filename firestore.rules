rules_version = '2';

// 근거: PLAN.md §7 「보안 규칙에서 특히 신경 쓸 것」.
//
// 서버(Admin SDK)는 이 규칙을 우회한다. 따라서 "서버만 쓰기"인 필드는
// 여기서 클라이언트의 쓰기를 막는 것으로 구현된다 — slides · caption ·
// intent · shortTitle 같은 AI 생성 필드가 그렇다.
//
// 여기에 match가 없는 경로는 전부 차단이 기본값이다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 본인 확인 — 모든 컬렉션에서 이 조건을 통과해야 한다 (원칙 ①)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 이번 쓰기에서 실제로 바뀐 필드 목록
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // users — 문서 ID = Firebase Auth uid. 계정 + 온보딩 4문항
    match /users/{uid} {
      allow read: if isOwner(uid);

      // 회원가입 직후 클라이언트가 만든다. 온보딩 완료 표시는 서버가 한다
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.onboardedAt == null;

      // 설정(활동 분야·빈도·말투·피할 표현)만 클라이언트가 고칠 수 있다.
      // onboardedAt은 라우트 가드의 근거라 클라이언트가 임의로 못 쓴다 (§7 메모)
      allow update: if isOwner(uid)
        && !changedKeys().hasAny(['uid', 'email', 'onboardedAt', 'createdAt'].toSet());

      // 탈퇴는 서버가 처리한다 (DELETE /api/users/me)
      allow delete: if false;
    }

    // plans — 기획 세션. 대화 1회 = plan 1건
    match /plans/{planId} {
      allow read: if isOwner(resource.data.userId);

      // 새 기획은 draft로 시작한다. 확정(confirmed)과 카드 수는 서버만 쓴다
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'draft'
        && request.resource.data.cardCount == 0;

      // status · cardCount는 서버만 쓰기 (§7 메모)
      allow update: if isOwner(resource.data.userId)
        && !changedKeys().hasAny(['userId', 'status', 'cardCount', 'createdAt'].toSet());

      // 기획 삭제 기능은 v1에 없다. 탈퇴 시 삭제는 서버가 한다
      allow delete: if false;
    }

    // cards — 콘텐츠 카드. 발행률의 분모
    match /cards/{cardId} {
      allow read: if isOwner(resource.data.userId);

      // 카드는 서버만 만든다 — 기획 확정 시 AI가 생성 (POST /api/plans/[planId]/confirm)
      allow create: if false;

      // 클라이언트 쓰기 허용: status · publishIntent · scheduledDate 등 (§7 메모)
      // AI 생성 필드(slides · caption · intent · shortTitle)는 서버만 쓴다 (원칙 ②)
      // status는 정해진 4개 값만 (08-31: crafted 제거), published로 갈 때는 publishedAt이 함께 (원칙 ③)
      // themeId도 정해진 3종만 (08-31) — 색을 직접 실어 넣지 못하게 서버 밖에서도 막는다.
      //   옛 카드엔 themeId가 없다. 없으면 통과시켜야 「올렸어요」 같은 수정이 막히지 않는다.
      allow update: if isOwner(resource.data.userId)
        && !changedKeys().hasAny(
          ['userId', 'planId', 'slides', 'caption', 'intent', 'shortTitle', 'createdAt'].toSet()
        )
        && request.resource.data.status in ['planned', 'pending', 'published', 'discarded']
        && (!('themeId' in request.resource.data)
            || request.resource.data.themeId in ['warm', 'editorial', 'graphic'])
        && (request.resource.data.status != 'published'
            || request.resource.data.publishedAt != null);

      // 버림은 삭제가 아니다 — discarded로만 바뀐다. 지우면 발행률 분모가 흔들린다 (원칙 ④)
      allow delete: if false;
    }
  }
}
