# aipmmarketing 환경변수 — 이 파일은 값 없이 **이름만** 담습니다.
#
# 쓰는 법: 이 파일을 `.env.local`로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# `.env.local`은 .gitignore로 막혀 있어 커밋되지 않습니다.
# 이 파일(.env.example)만 저장소에 올라가므로 **실제 값을 절대 적지 마세요.**

# ── Firebase 클라이언트 (브라우저에 노출됨) ──────────────────
# NEXT_PUBLIC_ 접두사가 붙은 값은 빌드 결과물에 그대로 들어갑니다.
# 이 값들은 비밀이 아닙니다 — 승인된 도메인과 보안 규칙으로 보호합니다.
# 값 위치: Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (서버 전용 · 진짜 비밀) ───────────────────
# ⚠️ NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 새어 나갑니다. 절대 붙이지 마세요.
# 이 키는 보안 규칙을 전부 우회합니다. 유출되면 DB 전체가 열립니다.
# 값 위치: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 줄바꿈은 \n 두 글자로 적고 전체를 따옴표로 감싸세요.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Anthropic Claude (서버 전용 · 진짜 비밀) ──────────────────
# ⚠️ NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 새어 나갑니다. 절대 붙이지 마세요.
# 비어 있으면 앱은 «모의 AI»로 동작합니다 — 화면은 다 돌지만 응답이 가짜입니다.
# 값 위치: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
